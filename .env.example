APP_NAME=RiskSentinelX
APP_VERSION=1.0.0
ENVIRONMENT=development

# Postgres DB
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/risksentinel

# Models and Thresholds
MODEL_PATH=/app/models/xgb-ieeecis-v1.bin
GRAPH_SUSPICIOUS_THRESHOLD=0.6

# AI Agent Configuration
AGENT_PROVIDER=mock
CLAUDE_API_KEY=sk-ant-dummy-key
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# Simulation
SIMULATION_EVENT_DELAY_MS=1500

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:8000/api/v1/stream/events
