APP_NAME="RiskSentinel X"
APP_VERSION=1.0.0
ENVIRONMENT=development

# -------------------------------------------------------
# DATABASE (Required)
# Create a free Supabase project at https://supabase.com
# Copy the Connection String from: Project Settings > Database
# -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# -------------------------------------------------------
# ML MODEL (Pre-trained model is included in the repo)
# Do NOT change these unless you retrain the model.
# -------------------------------------------------------
MODEL_PATH=/app/models/xgb-ieeecis-v1.json
GRAPH_SUSPICIOUS_THRESHOLD=0.6

# -------------------------------------------------------
# AI AGENT (Required)
# Get a free Gemini API key at https://aistudio.google.com
# AGENT_PROVIDER must be set to "gemini" for production.
# -------------------------------------------------------
AGENT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------------------
# STRIPE (Optional — only needed for webhook testing)
# -------------------------------------------------------
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -------------------------------------------------------
# SIMULATION
# -------------------------------------------------------
SIMULATION_EVENT_DELAY_MS=1500
