APP_NAME="RiskSentinel X"
APP_VERSION=1.0.0
ENVIRONMENT=development

# Postgres DB
DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/risksentinel

# Models and Thresholds
MODEL_PATH=/app/models/xgb-ieeecis-v1.bin
GRAPH_SUSPICIOUS_THRESHOLD=0.6

# AI Agent Configuration
AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Stripe Integration
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Simulation
SIMULATION_EVENT_DELAY_MS=1500

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:8000/api/v1/stream/events
